@model ToDoApp.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="delete-page">

    <div class="delete-card">

        <div class="delete-icon">
            <i class="bi bi-trash3"></i>
        </div>

        <h2>Delete Task?</h2>

        <p class="delete-message">
            Are you sure you want to delete this task?
            This action cannot be undone.
        </p>

        <div class="delete-details">

            <div class="delete-detail">
                <span>Task Title</span>
                <strong>@Model.Title</strong>
            </div>

            <div class="delete-detail">
                <span>Description</span>
                <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)</p>
            </div>

            <div class="delete-detail">
                <span>Due Date</span>
                <strong>
                    @Model.DueDate.ToString("dd MMM yyyy - hh:mm tt")
                </strong>
            </div>

            <div class="delete-detail">
                <span>Status</span>
                <strong>
                    @(Model.IsCompleted ? "Completed" : "Pending")
                </strong>
            </div>

            <div class="delete-detail">
                <span>Priority</span>
                <strong>@Model.Priority</strong>
            </div>

        </div>

        <form asp-action="Delete" method="post" class="delete-actions">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="delete-confirm-btn">
                <i class="bi bi-trash3"></i>
                Delete Task
            </button>

            <a asp-action="Index" class="delete-cancel-btn">
                Cancel
            </a>
        </form>

    </div>

</div>
